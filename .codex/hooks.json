{
  "hooks": {
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$(git rev-parse --show-toplevel)/.claude/hooks/coordinator_rotation.py\" hook --harness codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$(git rev-parse --show-toplevel)/.claude/hooks/coordinator_rotation.py\" hook --harness codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$(git rev-parse --show-toplevel)/.claude/hooks/coordinator_rotation.py\" hook --harness codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$(git rev-parse --show-toplevel)/.claude/hooks/coordinator_rotation.py\" hook --harness codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$(git rev-parse --show-toplevel)/.claude/hooks/coordinator_rotation.py\" hook --harness codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
